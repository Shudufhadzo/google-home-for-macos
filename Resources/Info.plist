<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key><string>en</string>
    <key>CFBundleExecutable</key><string>HomeSpeaker</string>
    <key>CFBundleIdentifier</key><string>za.shudu.homespeaker</string>
    <key>CFBundleIconFile</key><string>HomeSpeakerIcon</string>
    <key>CFBundleInfoDictionaryVersion</key><string>6.0</string>
    <key>CFBundleName</key><string>Home Manager</string>
    <key>CFBundleDisplayName</key><string>Home Manager</string>
    <key>CFBundlePackageType</key><string>APPL</string>
    <key>CFBundleShortVersionString</key><string>0.5.0</string>
    <key>CFBundleVersion</key><string>10</string>
    <key>LSMinimumSystemVersion</key><string>14.4</string>
    <key>NSHighResolutionCapable</key><true/>
    <key>NSLocalNetworkUsageDescription</key>
    <string>Discover speakers, home hubs, routers, and smart devices, and connect to your home hub on the local network.</string>
    <key>NSAudioCaptureUsageDescription</key>
    <string>Send sound playing on this Mac to your selected speaker over Wi-Fi.</string>
    <key>NSAppleEventsUsageDescription</key>
    <string>Show the song, artist, and artwork playing in Apple Music, and control playback while casting.</string>
    <key>NSBonjourServices</key>
    <array>
        <string>_googlecast._tcp</string>
        <string>_home-assistant._tcp</string>
        <string>_http._tcp</string>
        <string>_https._tcp</string>
        <string>_hap._tcp</string>
        <string>_matter._tcp</string>
        <string>_matterc._udp</string>
        <string>_airplay._tcp</string>
        <string>_ipp._tcp</string>
    </array>
    <key>NSAppTransportSecurity</key>
    <dict>
        <!-- Local IP HTTP endpoints need this exception. HomeEndpointPolicy confines
             HTTP to private LAN/loopback/link-local addresses; remote APIs require HTTPS. -->
        <key>NSAllowsArbitraryLoads</key><true/>
    </dict>
</dict>
</plist>
